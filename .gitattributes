# Normalize line endings
* text=auto

# Maven wrapper
/mvnw text eol=lf
/mvnw.cmd text eol=crlf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts
*.sh text eol=lf

# Java source files (optional but common)
*.java text eol=lf

# Gradle/Maven descriptors
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
